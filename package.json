{
  "name": "hatsunichi",
  "version": "0.1.0",
  "description": "鳥取の大学生が申し込まずに開ける、実データで減便を決める仕事の初日",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "build:town": "node scripts/build-town.mjs && node scripts/check-sources.mjs data/town.json",
    "check:sources": "node scripts/check-sources.mjs data/town.json",
    "postinstall": "node scripts/copy-worker.mjs",
    "prebuild": "node scripts/copy-worker.mjs",
    "predev": "node scripts/copy-worker.mjs",
    "demo": "node scripts/copy-worker.mjs && next build && npx --yes serve out",
    "review": "node --env-file-if-exists=.env scripts/review-server.ts",
    "deploy": "node scripts/deploy-pages.mjs",
    "eval": "node --env-file-if-exists=.env scripts/eval.ts",
    "eval:sheet": "node --env-file-if-exists=.env scripts/eval-sheet.ts",
    "record:replies": "node --env-file-if-exists=.env scripts/record-replies.ts",
    "record:routes": "node --env-file-if-exists=.env scripts/record-routes.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MS-TECH1015/hatsunichi.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/MS-TECH1015/hatsunichi/issues"
  },
  "homepage": "https://github.com/MS-TECH1015/hatsunichi#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "private": true
}
